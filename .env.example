# ============================================================
# Lumorius AI — Environment Variables
# INMARTECH PVT LTD
# ============================================================
# Development template only. Use a secret manager and production-specific
# endpoints and credentials for deployment.
# NEVER commit .env to version control.
# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================

# ---- App ---------------------------------------------------
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001/api

# ---- Database (PostgreSQL 15+) ----------------------------
DATABASE_URL=postgresql://lumorius:CHANGE_ME@localhost:5433/lumorius_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
# How long a request waits for a database connection (ms) before returning "busy, try again".
DATABASE_CONNECTION_TIMEOUT_MS=15000
DATABASE_SSL_CA=
POSTGRES_PASSWORD=

# ---- Redis (for BullMQ queues + rate limiting) ------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ---- JWT / Auth -------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX_STRING_HERE
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_64_CHARS

# ---- OAuth Providers (optional) ---------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Email / SMTP -----------------------------------------
# Supports: SendGrid, SES, Mailgun, Gmail SMTP, Postmark
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
EMAIL_FROM=no-reply@your-domain.com
# Verification / reset token TTL (hours / minutes)
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ---- Brute Force / Security --------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# ---- S3 / Object Storage ----------------------------------
# Compatible with AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=lumorius-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- AI Providers (at least one required) -----------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Only if your GPT-4.1 key comes from an OpenAI-compatible service (not api.openai.com):
# set that service's API address here, e.g. https://example-gateway.com/v1. Leave empty for OpenAI.
OPENAI_BASE_URL=
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=openai

# ---- OpenSearch (vector + full-text search) ---------------
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=

# ---- Stripe (billing in USD) ------------------------------
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Monitoring / Observability ---------------------------
SENTRY_DSN=
LOG_LEVEL=info

# ---- Organisation integrations (OAuth account tokens are encrypted at rest) ----
INTEGRATIONS_API_BASE_URL=http://localhost:3001/api/v1
# Generate once and keep stable: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=
# Exact UUID of the Lumorius platform organisation; leave blank to hide the platform Stripe card everywhere.
LUMORIUS_PLATFORM_ORGANIZATION_ID=

SLACK_CLIENT_ID=

SLACK_CLIENT_SECRET=

NOTION_CLIENT_ID=

NOTION_CLIENT_SECRET=

ATLASSIAN_CLIENT_ID=

ATLASSIAN_CLIENT_SECRET=

ZOOM_CLIENT_ID=

ZOOM_CLIENT_SECRET=

HUBSPOT_CLIENT_ID=

HUBSPOT_CLIENT_SECRET=



LINEAR_CLIENT_ID=

LINEAR_CLIENT_SECRET=

DROPBOX_CLIENT_ID=

DROPBOX_CLIENT_SECRET=

# ---- Payments: Dodo Payments (checkout + subscriptions) ---
# Checkout stays disabled until these are set. Create one product per plan
# and interval in the Dodo dashboard at the prices shown in the app:
#   Starter $49/mo, $490/yr · Growth $99/mo, $990/yr · Professional $199/mo, $1,990/yr
# Use "test" until you go live; production requires DODO_PAYMENTS_MODE=live.
DODO_PAYMENTS_MODE=test
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_STARTER_MONTHLY_PRODUCT_ID=
DODO_STARTER_ANNUAL_PRODUCT_ID=
DODO_GROWTH_MONTHLY_PRODUCT_ID=
DODO_GROWTH_ANNUAL_PRODUCT_ID=
DODO_PROFESSIONAL_MONTHLY_PRODUCT_ID=
DODO_PROFESSIONAL_ANNUAL_PRODUCT_ID=

# ---- Platform administration ----------------------------
# Only this account can open /admin (enforced by the API).
LUMORIUS_ADMIN_EMAIL=you@example.com
