# ============================================================
# Lumorius AI — Environment Variables
# INMARTECH PVT LTD
# ============================================================
# Copy this file to .env and fill in every value.
# NEVER commit .env to version control.
# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================

# ---- App ---------------------------------------------------
NODE_ENV=production
PORT=3001
APP_URL=https://your-domain.com
API_URL=https://your-domain.com/api

# ---- Database (PostgreSQL 15+) ----------------------------
DATABASE_URL=postgresql://lumorius:STRONG_PASSWORD@localhost:5432/lumorius_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ---- Redis (for BullMQ queues + rate limiting) ------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ---- JWT / Auth -------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX_STRING_HERE
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_64_CHARS

# ---- OAuth Providers (optional) ---------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Email / SMTP -----------------------------------------
# Supports: SendGrid, SES, Mailgun, Gmail SMTP, Postmark
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_API_KEY
EMAIL_FROM=no-reply@your-domain.com
# Verification / reset token TTL (hours / minutes)
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ---- Brute Force / Security --------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# ---- S3 / Object Storage ----------------------------------
# Compatible with AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=lumorius-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- AI Providers (at least one required) -----------------
OPENAI_API_KEY=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
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=openai

# ---- OpenSearch (vector + full-text search) ---------------
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=

# ---- Stripe (billing in USD) ------------------------------
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs — create these in the Stripe Dashboard
STRIPE_STARTER_MONTHLY=price_xxx
STRIPE_STARTER_ANNUAL=price_xxx
STRIPE_GROWTH_MONTHLY=price_xxx
STRIPE_GROWTH_ANNUAL=price_xxx
STRIPE_PROFESSIONAL_MONTHLY=price_xxx
STRIPE_PROFESSIONAL_ANNUAL=price_xxx
STRIPE_ENTERPRISE_MONTHLY=price_xxx
STRIPE_ENTERPRISE_ANNUAL=price_xxx

# ---- Monitoring / Observability ---------------------------
SENTRY_DSN=
LOG_LEVEL=info
