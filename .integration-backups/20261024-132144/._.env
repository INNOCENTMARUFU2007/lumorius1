# ============================================================
# Lumorius AI — Environment Variables
# INMARTECH PVT LTD
# ============================================================
# Copy this file to .env and fill in every value.
# NEVER commit .env to version control.
# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================

# ---- App ---------------------------------------------------
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001/api

# ---- Database (PostgreSQL 15+) ----------------------------
DATABASE_URL=postgresql://lumorius:LumoriusLocalDB_2026@localhost:5433/lumorius_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ---- Redis (for BullMQ queues + rate limiting) ------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ---- JWT / Auth -------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=9235938ad2fda4e7c9f32e991f392470dea38f058264cbd59826339e7e584cc569801df60787dcabaf13a28f10ccbcb3e9fc743856d644f045470d94ebabe50a
JWT_REFRESH_SECRET=f386752cca4984f81a2ab3f4e3084e7ab6dd86e47adbdf8b7431606c785da161a3698cce162953671d0c618d1349bae4e352e67d36635971d6e7e6d8cebbcae0
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=3e60471c508812cabda8e3dd277346b1ceaafc1f9f80d5d05c7833b30f501d58da550b04e9a06b04737e14ff2b510d9d0482c04630dbd0b07b2726038c890f6d

# ---- OAuth Providers (optional) ---------------------------
GOOGLE_CLIENT_ID=local-development-google-client-id
GOOGLE_CLIENT_SECRET=local-development-google-secret
GITHUB_CLIENT_ID=local-development-github-client-id
GITHUB_CLIENT_SECRET=local-development-github-secret
MICROSOFT_CLIENT_ID=local-development-microsoft-client-id
MICROSOFT_CLIENT_SECRET=local-development-microsoft-secret
# ---- Gmail SMTP for Lumorius ------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lumorius1@gmail.com
SMTP_PASS=soehzpvojegtimsi
EMAIL_FROM=lumorius1@gmail.com
# Verification / reset token TTL (hours / minutes)
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# ---- Brute Force / Security --------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# ---- S3 / Object Storage ----------------------------------
# Compatible with AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=lumorius-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- AI Providers (at least one required) -----------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=openai

# ---- OpenSearch (vector + full-text search) ---------------
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=

# ---- Stripe (billing in USD) ------------------------------
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs — create these in the Stripe Dashboard
STRIPE_STARTER_MONTHLY=price_xxx
STRIPE_STARTER_ANNUAL=price_xxx
STRIPE_GROWTH_MONTHLY=price_xxx
STRIPE_GROWTH_ANNUAL=price_xxx
STRIPE_PROFESSIONAL_MONTHLY=price_xxx
STRIPE_PROFESSIONAL_ANNUAL=price_xxx
STRIPE_ENTERPRISE_MONTHLY=price_xxx
STRIPE_ENTERPRISE_ANNUAL=price_xxx

# ---- Monitoring / Observability ---------------------------
SENTRY_DSN=
LOG_LEVEL=info
