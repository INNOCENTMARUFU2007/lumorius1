
'use client';

import Image from 'next/image';
import { useEffect, useState } from 'react';
import { useRouter } from 'next/navigation';
import { motion } from 'framer-motion';
import { CheckCircle, XCircle, Loader2, Mail } from 'lucide-react';
import api from '@/lib/api';
import Link from 'next/link';

type State = 'loading' | 'success' | 'error' | 'no-token';

export default function VerifyEmailPage() {
  const router = useRouter();

  const [token, setToken] = useState<string | null>(null);
  const [state, setState] = useState<State>('loading');
  const [error, setError] = useState('');

  // Read the query string in the browser instead of using useSearchParams().
  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    const verificationToken = params.get('token');

    if (verificationToken) {
      setToken(verificationToken);
    } else {
      setState('no-token');
    }
  }, []);

  // Verify the token after the browser has loaded the page.
  useEffect(() => {
    if (!token) return;

    let cancelled = false;
    let redirectTimer: ReturnType<typeof setTimeout> | undefined;

    api
      .post('/auth/verify-email', { token })
      .then(() => {
        if (cancelled) return;

        setState('success');

        redirectTimer = setTimeout(() => {
          router.push('/dashboard');
        }, 3000);
      })
      .catch((err) => {
        if (cancelled) return;

        setError(
          err?.response?.data?.message ?? 'Verification failed'
        );
        setState('error');
      });

    return () => {
      cancelled = true;

      if (redirectTimer) {
        clearTimeout(redirectTimer);
      }
    };
  }, [token, router]);

  return (
    <div className="min-h-screen bg-gray-950 flex items-center justify-center px-4">
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        className="w-full max-w-md"
      >
        <div className="text-center mb-8">
          <div className="inline-flex items-center justify-center">
            <Image
              src="/logo.svg"
              alt="Lumorius"
              width={48}
              height={48}
              priority
              className="w-12 h-12 sm:w-14 sm:h-14"
            />
          </div>

          <div className="mt-3 flex justify-center">
            <Image
              src="/logo-wordmark.svg"
              alt="Lumorius"
              width={170}
              height={40}
              priority
              className="w-auto h-8 sm:h-9"
            />
          </div>
        </div>

        <div className="bg-gray-900 border border-gray-800 rounded-2xl p-8 text-center">
          {state === 'loading' && (
            <>
              <div className="w-16 h-16 mx-auto mb-4 bg-violet-500/10 rounded-full flex items-center justify-center">
                <Loader2 className="w-8 h-8 text-violet-400 animate-spin" />
              </div>

              <h1 className="text-xl font-bold text-white mb-2">
                Verifying your email…
              </h1>

              <p className="text-gray-400 text-sm">
                Please wait a moment.
              </p>
            </>
          )}

          {state === 'success' && (
            <>
              <motion.div
                initial={{ scale: 0 }}
                animate={{ scale: 1 }}
                transition={{ type: 'spring', stiffness: 200 }}
                className="w-16 h-16 mx-auto mb-4 bg-emerald-500/10 rounded-full flex items-center justify-center"
              >
                <CheckCircle className="w-8 h-8 text-emerald-400" />
              </motion.div>

              <h1 className="text-xl font-bold text-white mb-2">
                Email verified! ✓
              </h1>

              <p className="text-gray-400 text-sm mb-6">
                Your email has been confirmed. Redirecting you to the
                dashboard…
              </p>

              <Link
                href="/dashboard"
                className="inline-block px-6 py-3 bg-violet-600 hover:bg-violet-700 text-white rounded-xl font-semibold text-sm transition"
              >
                Go to Dashboard →
              </Link>
            </>
          )}

          {state === 'error' && (
            <>
              <div className="w-16 h-16 mx-auto mb-4 bg-red-500/10 rounded-full flex items-center justify-center">
                <XCircle className="w-8 h-8 text-red-400" />
              </div>

              <h1 className="text-xl font-bold text-white mb-2">
                Verification failed
              </h1>

              <p className="text-gray-400 text-sm mb-2">
                {error}
              </p>

              <p className="text-gray-500 text-xs mb-6">
                The link may have expired or already been used.
              </p>

              <div className="space-y-2">
                <Link
                  href="/dashboard"
                  className="block px-6 py-3 bg-violet-600 hover:bg-violet-700 text-white rounded-xl font-semibold text-sm transition text-center"
                >
                  Go to Dashboard
                </Link>

                <button
                  type="button"
                  onClick={() => {
                    api
                      .post('/auth/resend-verification')
                      .then(() =>
                        alert('New verification email sent!')
                      )
                      .catch(() =>
                        alert('Unable to resend the verification email. Please try again.')
                      );
                  }}
                  className="block w-full px-6 py-3 border border-gray-700 hover:bg-gray-800 text-gray-300 rounded-xl text-sm transition"
                >
                  Resend verification email
                </button>
              </div>
            </>
          )}

          {state === 'no-token' && (
            <>
              <div className="w-16 h-16 mx-auto mb-4 bg-violet-500/10 rounded-full flex items-center justify-center">
                <Mail className="w-8 h-8 text-violet-400" />
              </div>

              <h1 className="text-xl font-bold text-white mb-2">
                Check your inbox
              </h1>

              <p className="text-gray-400 text-sm mb-6">
                We sent a verification link to your email. Click the
                link to verify your account.
              </p>

              <Link
                href="/dashboard"
                className="inline-block px-6 py-3 border border-gray-700 hover:bg-gray-800 text-gray-300 rounded-xl text-sm transition"
              >
                Back to Dashboard
              </Link>
            </>
          )}
        </div>
      </motion.div>
    </div>
  );
}
